<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Substituído Toolbar por MaterialToolbar com ícone de navegação -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSobre"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:elevation="4dp"
        app:title="@string/titulo_sobre"
        app:titleTextColor="@color/onPrimary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/onPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvSobreTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/descricao_sobre"
                android:textColor="@color/brandPrimaryText"
                android:textSize="16sp"
                android:gravity="center_horizontal"
                android:paddingBottom="32dp" />

            <TextView
                android:id="@+id/tvTituloEquipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_equipe"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/brandPrimaryText"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingBottom="32dp" />

            <!-- Membros da equipe -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Membro 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@mipmap/ale_foto"
                        android:contentDescription="@string/cd_foto_membro_1"
                        app:shapeAppearanceOverlay="@style/SimulappCircleImage"
                        app:strokeColor="@color/neutralGray"
                        app:strokeWidth="1dp"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro1_nome"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/brandPrimaryText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro1_email"
                            android:textColor="@color/neutralGray"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro1_funcao"
                            android:textColor="@color/neutralGray"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Membro 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@mipmap/gus_foto"
                        android:contentDescription="@string/cd_foto_membro_2"
                        app:shapeAppearanceOverlay="@style/SimulappCircleImage"
                        app:strokeColor="@color/neutralGray"
                        app:strokeWidth="1dp"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro2_nome"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/brandPrimaryText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro2_email"
                            android:textColor="@color/neutralGray"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro2_funcao"
                            android:textColor="@color/neutralGray"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Membro 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@mipmap/maria_foto"
                        android:contentDescription="@string/cd_foto_membro_3"
                        app:shapeAppearanceOverlay="@style/SimulappCircleImage"
                        app:strokeColor="@color/neutralGray"
                        app:strokeWidth="1dp"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro3_nome"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/brandPrimaryText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro3_email"
                            android:textColor="@color/neutralGray"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/membro3_funcao"
                            android:textColor="@color/neutralGray"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
